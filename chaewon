import cv2
import numpy as np
import requests
import time

# =========================================================
# 기존에 잘 실행되던 Pinky 환경 그대로 사용
# - 새 서버 X
# - 새 라이브러리 X
# - 외부 이미지 파일 X
# =========================================================
HOST = "http://192.168.4.1:8000"

# =========================================================
# 주행 설정
# =========================================================
DRIVE_SPEED = 25
TURN_SPEED = 22
STOP_PAUSE = 0.30
STATE_IGNORE_TIME = 0.60

# =========================================================
# 영상 처리 설정
# 기존 파일에서 쓰던 HSV/ROI 값 그대로 사용
# =========================================================
ROI_START_RATIO = 0.58

LOWER_WHITE = np.array([0, 0, 175])
UPPER_WHITE = np.array([180, 75, 255])
LOWER_BLACK = np.array([0, 0, 0])
UPPER_BLACK = np.array([180, 255, 80])

MIN_AREA = 500
MIN_WIDTH = 25
ARROW_FILL_GAP_RATIO = 0.38
ARROW_MIN_AREA = 700

ARROW_CONFIRM_FRAMES = 3
ARROW_GONE_FRAMES = 4
TEXT_CONFIRM_FRAMES = 3

# 글자 덩어리 검출 기준
TEXT_MIN_AREA = 25
TEXT_MAX_AREA = 5000
STOP_MIN_PARTS = 3
STATION_MIN_PARTS = 4
GOAL_MIN_PARTS = 3

# =========================================================
# 상태
# =========================================================
FIRST_STRAIGHT = "FIRST_STRAIGHT"
TURN_TO_FIRST_STOP = "TURN_TO_FIRST_STOP"
DRIVE_TO_STATION_ARROW = "DRIVE_TO_STATION_ARROW"
TURN_TO_STATION = "TURN_TO_STATION"
DRIVE_TO_SECOND_STOP_ARROW = "DRIVE_TO_SECOND_STOP_ARROW"
TURN_TO_SECOND_STOP = "TURN_TO_SECOND_STOP"
DRIVE_TO_REVERSE_ARROW = "DRIVE_TO_REVERSE_ARROW"
TURN_TO_NORMAL_ARROW = "TURN_TO_NORMAL_ARROW"
DRIVE_TO_GOAL = "DRIVE_TO_GOAL"
DONE = "DONE"

state = FIRST_STRAIGHT
auto_mode = False
state_start_time = 0.0

arrow_count = 0
normal_arrow_direction = None
reverse_arrow_direction = None

on_counter = 0
off_counter = 0
detect_locked = False


# =========================================================
# 모터 제어 - 기존 파일 그대로
# =========================================================
def drive(left, right):
    left = int(np.clip(left, -100, 100))
    right = int(np.clip(right, -100, 100))

    try:
        requests.post(
            HOST + "/drive",
            json={"l": left, "r": right},
            timeout=0.3
        )
    except requests.RequestException:
        pass


def stop():
    try:
        requests.post(
            HOST + "/stop",
            timeout=0.3
        )
    except requests.RequestException:
        pass


# =========================================================
# 기본 영상 처리
# =========================================================
def remove_small_components(mask, min_area):
    n, labels, stats, _ = cv2.connectedComponentsWithStats(mask, 8)
    cleaned = np.zeros_like(mask)

    for i in range(1, n):
        if stats[i, cv2.CC_STAT_AREA] >= min_area:
            cleaned[labels == i] = 255

    return cleaned


def fill_arrow_gaps(white_mask):
    filled = white_mask.copy()
    h, w = white_mask.shape
    max_gap = int(w * ARROW_FILL_GAP_RATIO)

    for y in range(h):
        xs = np.where(white_mask[y] == 255)[0]
        if len(xs) == 0:
            continue

        groups = np.split(xs, np.where(np.diff(xs) > 1)[0] + 1)
        groups = [g for g in groups if len(g) >= MIN_WIDTH]

        for i in range(len(groups) - 1):
            left_end = int(groups[i][-1])
            right_start = int(groups[i + 1][0])
            gap = right_start - left_end - 1

            if 0 < gap <= max_gap:
                filled[y, left_end:right_start + 1] = 255

    return cv2.morphologyEx(
        filled,
        cv2.MORPH_CLOSE,
        np.ones((3, 5), np.uint8),
        iterations=1
    )


# =========================================================
# 화살표 방향 판별
# 첫 화살표 방향을 "정상 방향"으로 자동 기억
# =========================================================
def classify_arrow_direction(crop):
    h, w = crop.shape

    if h < 12 or w < 8:
        return "UNKNOWN"

    widths = np.count_nonzero(crop, axis=1).astype(np.float32)
    zone = max(2, int(h * 0.32))

    top = float(np.mean(widths[:zone]))
    bottom = float(np.mean(widths[-zone:]))

    if top > bottom * 1.15:
        return "UP"

    if bottom > top * 1.15:
        return "DOWN"

    return "UNKNOWN"


def opposite_direction(direction):
    if direction == "UP":
        return "DOWN"
    if direction == "DOWN":
        return "UP"
    return "UNKNOWN"


# =========================================================
# 기존 코드의 검은색 contour 방식으로 화살표 검출
# 외부 이미지/모델 없음
# =========================================================
def detect_arrow(hsv, road_mask):
    black_mask = cv2.inRange(hsv, LOWER_BLACK, UPPER_BLACK)
    arrow_mask = cv2.bitwise_and(black_mask, road_mask)

    arrow_mask = cv2.morphologyEx(
        arrow_mask,
        cv2.MORPH_OPEN,
        np.ones((3, 3), np.uint8),
        iterations=1
    )

    contours, _ = cv2.findContours(
        arrow_mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    best_area = 0.0
    best_direction = "UNKNOWN"
    best_box = None
    _, roi_w = arrow_mask.shape

    for contour in contours:
        area = cv2.contourArea(contour)
        if area < ARROW_MIN_AREA:
            continue

        x, y, cw, ch = cv2.boundingRect(contour)
        center_x = x + cw // 2

        if center_x < int(roi_w * 0.15) or center_x > int(roi_w * 0.85):
            continue

        # 가로로 너무 긴 것은 글씨/경계일 가능성이 높음
        if cw > ch * 3.0:
            continue

        if area > best_area:
            crop = arrow_mask[y:y + ch, x:x + cw]
            best_area = area
            best_direction = classify_arrow_direction(crop)
            best_box = (x, y, cw, ch)

    return (
        best_box is not None,
        best_direction,
        arrow_mask,
        best_area,
        best_box
    )


# =========================================================
# STOP / STATION / GOAL 검출
# OCR을 새로 설치하지 않는다.
# 여러 검은 글자 조각이 한 줄에 나타나는지만 본다.
# 어떤 단어인지는 현재 상태 순서로 판단한다.
# =========================================================
def detect_text_sign(hsv, min_parts):
    black_mask = cv2.inRange(hsv, LOWER_BLACK, UPPER_BLACK)
    roi_h, roi_w = black_mask.shape

    focus = np.zeros_like(black_mask)
    x1 = int(roi_w * 0.10)
    x2 = int(roi_w * 0.90)
    focus[:, x1:x2] = black_mask[:, x1:x2]

    focus = cv2.morphologyEx(
        focus,
        cv2.MORPH_OPEN,
        np.ones((2, 2), np.uint8),
        iterations=1
    )

    contours, _ = cv2.findContours(
        focus,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    parts = []

    for contour in contours:
        area = cv2.contourArea(contour)
        if area < TEXT_MIN_AREA or area > TEXT_MAX_AREA:
            continue

        x, y, cw, ch = cv2.boundingRect(contour)

        if ch < 7 or ch > int(roi_h * 0.45):
            continue
        if cw < 3 or cw > int(roi_w * 0.30):
            continue

        parts.append({
            "x": x,
            "y": y,
            "w": cw,
            "h": ch,
            "cy": y + ch / 2.0
        })

    # 같은 높이에 있는 글자들을 한 단어 후보로 묶기
    best_group = []
    y_tol = roi_h * 0.12

    for base in parts:
        group = [p for p in parts if abs(p["cy"] - base["cy"]) <= y_tol]
        if len(group) > len(best_group):
            best_group = group

    found = False
    box = None

    if len(best_group) >= min_parts:
        min_x = min(p["x"] for p in best_group)
        max_x = max(p["x"] + p["w"] for p in best_group)
        min_y = min(p["y"] for p in best_group)
        max_y = max(p["y"] + p["h"] for p in best_group)

        if (max_x - min_x) >= int(roi_w * 0.10):
            found = True
            box = (min_x, min_y, max_x - min_x, max_y - min_y)

    return found, focus, len(best_group), box


# =========================================================
# 연속 프레임 확인
# =========================================================
def reset_detection():
    global on_counter, off_counter, detect_locked
    on_counter = 0
    off_counter = 0
    detect_locked = False


def update_detection(found, confirm_frames, gone_frames=ARROW_GONE_FRAMES):
    global on_counter, off_counter, detect_locked

    rise = False
    fall = False

    if found:
        off_counter = 0

        if not detect_locked:
            on_counter += 1

            if on_counter >= confirm_frames:
                detect_locked = True
                on_counter = 0
                rise = True

    else:
        on_counter = 0

        if detect_locked:
            off_counter += 1

            if off_counter >= gone_frames:
                detect_locked = False
                off_counter = 0
                fall = True

    return rise, fall


# =========================================================
# 상태 변경
# 항상 먼저 정지한 뒤 다음 상태로 감
# =========================================================
def change_state(new_state):
    global state, state_start_time

    stop()
    time.sleep(STOP_PAUSE)

    state = new_state
    state_start_time = time.monotonic()
    reset_detection()

    print(f"STATE -> {state}")


# =========================================================
# 카메라 - 기존 파일 그대로
# =========================================================
cap = cv2.VideoCapture(HOST + "/video")

if not cap.isOpened():
    print("카메라 연결 실패")
    raise SystemExit


print("""
=================================================
Pinky Pro - Simple Route
=================================================
P       : AUTO ON/OFF
W/S/A/D : 수동
SPACE   : 정지
R       : 초기화
ESC     : 종료

AUTO 순서
1) 직진
2) 두 번째 화살표가 화면에서 사라짐 -> 정지 -> 우회전
3) STOP 형태 보임 -> 정지 -> 직진
4) 다음 화살표 -> 정지 -> 우회전
5) STATION 형태 보임 -> 정지 -> 직진
6) 다음 화살표 -> 정지 -> 우회전
7) STOP 형태 보임 -> 정지 -> 직진
8) 반대방향 화살표 -> 정지 -> 우회전
9) 정상방향 화살표 -> 정지 -> 직진
10) GOAL 형태 보임 -> 최종 정지
=================================================
""")


# =========================================================
# 메인 루프
# =========================================================
while True:
    ret, frame = cap.read()

    if not ret:
        print("영상 수신 실패")
        stop()
        break

    h, w = frame.shape[:2]
    roi_start = int(h * ROI_START_RATIO)
    roi = frame[roi_start:h, :]
    roi_h, roi_w = roi.shape[:2]

    roi_blur = cv2.GaussianBlur(roi, (5, 5), 0)
    hsv = cv2.cvtColor(roi_blur, cv2.COLOR_BGR2HSV)

    # -----------------------------------------------------
    # 흰 도로: 화살표가 도로 안에 있는지만 보기 위해 사용
    # 중심선 추종에는 사용하지 않음
    # -----------------------------------------------------
    white_mask = cv2.inRange(hsv, LOWER_WHITE, UPPER_WHITE)
    white_mask = cv2.morphologyEx(
        white_mask,
        cv2.MORPH_OPEN,
        np.ones((3, 3), np.uint8),
        iterations=1
    )
    white_mask = remove_small_components(white_mask, MIN_AREA)
    road_mask = fill_arrow_gaps(white_mask)

    # -----------------------------------------------------
    # 화살표
    # -----------------------------------------------------
    (
        arrow_found,
        arrow_direction,
        arrow_mask,
        arrow_area,
        arrow_box
    ) = detect_arrow(hsv, road_mask)

    # -----------------------------------------------------
    # 글씨 표식
    # -----------------------------------------------------
    text_found = False
    text_mask = np.zeros_like(white_mask)
    text_parts = 0
    text_box = None

    if state in (TURN_TO_FIRST_STOP, TURN_TO_SECOND_STOP):
        text_found, text_mask, text_parts, text_box = detect_text_sign(
            hsv,
            STOP_MIN_PARTS
        )

    elif state == TURN_TO_STATION:
        text_found, text_mask, text_parts, text_box = detect_text_sign(
            hsv,
            STATION_MIN_PARTS
        )

    elif state == DRIVE_TO_GOAL:
        text_found, text_mask, text_parts, text_box = detect_text_sign(
            hsv,
            GOAL_MIN_PARTS
        )

    detection_enabled = (
        time.monotonic() - state_start_time >= STATE_IGNORE_TIME
    )

    # =====================================================
    # AUTO
    # =====================================================
    if auto_mode:

        # 1) 처음 직진, 화살표 2개 카운트
        if state == FIRST_STRAIGHT:
            drive(DRIVE_SPEED, DRIVE_SPEED)

            if detection_enabled:
                rise, fall = update_detection(
                    arrow_found,
                    ARROW_CONFIRM_FRAMES
                )

                if rise:
                    arrow_count += 1

                    if arrow_direction != "UNKNOWN":
                        normal_arrow_direction = arrow_direction

                    print(f"ARROW COUNT = {arrow_count}")
                    print(f"NORMAL DIR = {normal_arrow_direction}")

                # 핵심: 2번째 화살표가 화면에서 사라지면 즉시 정지 -> 우회전
                if fall and arrow_count >= 2:
                    print("ARROW 2 DISAPPEARED")
                    print("STOP -> RIGHT TURN")
                    change_state(TURN_TO_FIRST_STOP)

        # 2) STOP이 보일 때까지 우회전
        elif state == TURN_TO_FIRST_STOP:
            drive(TURN_SPEED, -TURN_SPEED)

            if detection_enabled:
                rise, _ = update_detection(text_found, TEXT_CONFIRM_FRAMES)
                if rise:
                    print("STOP FOUND -> STRAIGHT")
                    change_state(DRIVE_TO_STATION_ARROW)

        # 3) 다음 화살표까지 직진
        elif state == DRIVE_TO_STATION_ARROW:
            drive(DRIVE_SPEED, DRIVE_SPEED)

            if detection_enabled:
                rise, _ = update_detection(arrow_found, ARROW_CONFIRM_FRAMES)
                if rise:
                    print("ARROW FOUND -> TURN TO STATION")
                    change_state(TURN_TO_STATION)

        # 4) STATION이 보일 때까지 우회전
        elif state == TURN_TO_STATION:
            drive(TURN_SPEED, -TURN_SPEED)

            if detection_enabled:
                rise, _ = update_detection(text_found, TEXT_CONFIRM_FRAMES)
                if rise:
                    print("STATION FOUND -> STRAIGHT")
                    change_state(DRIVE_TO_SECOND_STOP_ARROW)

        # 5) 다음 화살표까지 직진
        elif state == DRIVE_TO_SECOND_STOP_ARROW:
            drive(DRIVE_SPEED, DRIVE_SPEED)

            if detection_enabled:
                rise, _ = update_detection(arrow_found, ARROW_CONFIRM_FRAMES)
                if rise:
                    print("ARROW FOUND -> TURN TO STOP")
                    change_state(TURN_TO_SECOND_STOP)

        # 6) STOP이 보일 때까지 우회전
        elif state == TURN_TO_SECOND_STOP:
            drive(TURN_SPEED, -TURN_SPEED)

            if detection_enabled:
                rise, _ = update_detection(text_found, TEXT_CONFIRM_FRAMES)
                if rise:
                    print("STOP FOUND -> STRAIGHT")
                    change_state(DRIVE_TO_REVERSE_ARROW)

        # 7) 반대방향 화살표까지 직진
        elif state == DRIVE_TO_REVERSE_ARROW:
            drive(DRIVE_SPEED, DRIVE_SPEED)

            reverse_candidate = False

            if arrow_found:
                if normal_arrow_direction in ("UP", "DOWN"):
                    reverse_candidate = (
                        arrow_direction == opposite_direction(normal_arrow_direction)
                    )
                else:
                    # 정상 방향 판별이 실패했을 경우 이 구간의 첫 화살표 사용
                    reverse_candidate = True

            if detection_enabled:
                rise, _ = update_detection(
                    reverse_candidate,
                    ARROW_CONFIRM_FRAMES
                )

                if rise:
                    if arrow_direction != "UNKNOWN":
                        reverse_arrow_direction = arrow_direction

                    print("REVERSE ARROW FOUND -> RIGHT TURN")
                    change_state(TURN_TO_NORMAL_ARROW)

        # 8) 정상방향 화살표가 보일 때까지 우회전
        elif state == TURN_TO_NORMAL_ARROW:
            drive(TURN_SPEED, -TURN_SPEED)

            normal_candidate = False

            if arrow_found:
                if normal_arrow_direction in ("UP", "DOWN"):
                    normal_candidate = (
                        arrow_direction == normal_arrow_direction
                    )
                elif reverse_arrow_direction in ("UP", "DOWN"):
                    normal_candidate = (
                        arrow_direction == opposite_direction(reverse_arrow_direction)
                    )
                else:
                    normal_candidate = True

            if detection_enabled:
                rise, _ = update_detection(
                    normal_candidate,
                    ARROW_CONFIRM_FRAMES
                )

                if rise:
                    print("NORMAL ARROW FOUND -> FINAL STRAIGHT")
                    change_state(DRIVE_TO_GOAL)

        # 9) GOAL까지 직진
        elif state == DRIVE_TO_GOAL:
            drive(DRIVE_SPEED, DRIVE_SPEED)

            if detection_enabled:
                rise, _ = update_detection(text_found, TEXT_CONFIRM_FRAMES)
                if rise:
                    print("GOAL FOUND")
                    change_state(DONE)

        elif state == DONE:
            stop()
            auto_mode = False
            print("GOAL COMPLETE -> AUTO OFF")

    # =====================================================
    # 화면 표시
    # =====================================================
    result = frame.copy()

    cv2.line(
        result,
        (0, roi_start),
        (w, roi_start),
        (0, 255, 255),
        2
    )

    if arrow_box is not None:
        x, y, cw, ch = arrow_box
        cv2.rectangle(
            result,
            (x, y + roi_start),
            (x + cw, y + ch + roi_start),
            (0, 255, 0),
            2
        )

    if text_box is not None:
        x, y, cw, ch = text_box
        cv2.rectangle(
            result,
            (x, y + roi_start),
            (x + cw, y + ch + roi_start),
            (0, 0, 255),
            2
        )

    mode_text = "AUTO" if auto_mode else "MANUAL"

    cv2.putText(result, f"MODE: {mode_text}", (20, 30),
                cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 0, 0), 2)
    cv2.putText(result, f"STATE: {state}", (20, 58),
                cv2.FONT_HERSHEY_SIMPLEX, 0.48, (255, 0, 0), 2)
    cv2.putText(result, f"ARROW COUNT: {arrow_count}", (20, 86),
                cv2.FONT_HERSHEY_SIMPLEX, 0.50, (255, 0, 0), 2)
    cv2.putText(result, f"ARROW DIR: {arrow_direction}", (20, 114),
                cv2.FONT_HERSHEY_SIMPLEX, 0.50, (255, 0, 0), 2)
    cv2.putText(result, f"NORMAL DIR: {normal_arrow_direction}", (20, 142),
                cv2.FONT_HERSHEY_SIMPLEX, 0.50, (255, 0, 0), 2)
    cv2.putText(result, f"TEXT PARTS: {text_parts}", (20, 170),
                cv2.FONT_HERSHEY_SIMPLEX, 0.50, (255, 0, 0), 2)

    cv2.imshow("Pinky Main", result)
    cv2.imshow("Arrow Mask", arrow_mask)
    cv2.imshow("Text Mask", text_mask)

    # =====================================================
    # 키보드 - 기존 방식 유지
    # =====================================================
    key = cv2.waitKey(1) & 0xFF

    if key == ord("p"):
        auto_mode = not auto_mode
        stop()
        state_start_time = time.monotonic()
        reset_detection()
        print("AUTO ON" if auto_mode else "AUTO OFF")

    elif key == ord("w"):
        auto_mode = False
        drive(30, 30)

    elif key == ord("s"):
        auto_mode = False
        drive(-30, -30)

    elif key == ord("a"):
        auto_mode = False
        drive(-25, 25)

    elif key == ord("d"):
        auto_mode = False
        drive(25, -25)

    elif key == 32:
        auto_mode = False
        stop()
        print("STOP")

    elif key == ord("r"):
        auto_mode = False
        state = FIRST_STRAIGHT
        state_start_time = 0.0
        arrow_count = 0
        normal_arrow_direction = None
        reverse_arrow_direction = None
        reset_detection()
        stop()
        print("RESET")

    elif key == 27:
        stop()
        break


stop()
cap.release()
cv2.destroyAllWindows()
print("종료")
