import cv2
import time
from pathlib import Path
from pinkylib import Camera, Motor


# =========================================================
# Pinky Pro - Raspberry Pi 내부 실행용
#
# 노트북은 SSH만 사용.
# requests / HOST / HTTP server 사용하지 않음.
#
# 필요한 템플릿 이미지(이 파일과 같은 폴더):
#   arrow_normal.png
#   arrow_reverse.png
#   stop.png
#   station.png
#   goal.png
#
# 각 이미지는 로봇 카메라 화면에서 해당 표식만
# 최대한 타이트하게 잘라 저장한 이미지로 준비.
# =========================================================


# =========================================================
# 1. 주행 속도
# =========================================================
DRIVE_SPEED = 23
TURN_SPEED = 22

# 반드시 "정지 → 회전/출발" 순서를 만들기 위한 대기
STOP_PAUSE = 0.40

# CPU 부하를 줄이기 위해 N프레임마다 표식 검사
DETECT_EVERY_N_FRAMES = 2

# 상태가 바뀐 직후 같은 표식을 다시 잡는 것 방지
IGNORE_AFTER_STATE_CHANGE = 0.60


# =========================================================
# 2. Template Matching 기준
#
# 실제 카메라에서 score를 보고 조금씩 조정 가능.
# 너무 안 잡히면 0.72 -> 0.65 정도로 낮춘다.
# 오검출이 많으면 값을 높인다.
# =========================================================
THRESHOLDS = {
    "arrow_normal": 0.72,
    "arrow_reverse": 0.72,
    "stop": 0.70,
    "station": 0.70,
    "goal": 0.70,
}

# 연속 몇 번 보여야 진짜 표식으로 확정할지
STABLE_ON_FRAMES = 3

# 연속 몇 번 안 보여야 화면에서 사라졌다고 확정할지
STABLE_OFF_FRAMES = 4

# 첫 번째/두 번째 화살표를 같은 화살표로 중복 카운트하지 않도록
ARROW_EVENT_COOLDOWN = 1.5


# =========================================================
# 3. 상태 이름
# =========================================================
FIRST_STRAIGHT = "FIRST_STRAIGHT"

TURN_TO_STOP_1 = "TURN_TO_STOP_1"

DRIVE_TO_ARROW_STATION = "DRIVE_TO_ARROW_STATION"
TURN_TO_STATION = "TURN_TO_STATION"

DRIVE_TO_ARROW_STOP = "DRIVE_TO_ARROW_STOP"
TURN_TO_STOP_2 = "TURN_TO_STOP_2"

DRIVE_TO_REVERSE_ARROW = "DRIVE_TO_REVERSE_ARROW"
TURN_TO_NORMAL_ARROW = "TURN_TO_NORMAL_ARROW"

DRIVE_TO_GOAL = "DRIVE_TO_GOAL"

DONE = "DONE"


# =========================================================
# 4. 표식 안정화 클래스
#
# 한 프레임만 잠깐 잡혔다고 바로 판단하지 않고
# 몇 프레임 연속 보여야 "등장",
# 몇 프레임 연속 안 보여야 "사라짐" 처리.
# =========================================================
class StablePresence:

    def __init__(
        self,
        on_frames=STABLE_ON_FRAMES,
        off_frames=STABLE_OFF_FRAMES
    ):
        self.on_frames = on_frames
        self.off_frames = off_frames

        self.on_count = 0
        self.off_count = 0

        self.active = False


    def reset(self):

        self.on_count = 0
        self.off_count = 0
        self.active = False


    def update(self, detected):

        event = None

        if detected:

            self.on_count += 1
            self.off_count = 0

            if (
                not self.active
                and self.on_count >= self.on_frames
            ):
                self.active = True
                event = "rise"

        else:

            self.off_count += 1
            self.on_count = 0

            if (
                self.active
                and self.off_count >= self.off_frames
            ):
                self.active = False
                event = "fall"

        return event


# =========================================================
# 5. Template 읽기
# =========================================================
BASE_DIR = Path(__file__).resolve().parent

TEMPLATE_FILES = {
    "arrow_normal": "arrow_normal.png",
    "arrow_reverse": "arrow_reverse.png",
    "stop": "stop.png",
    "station": "station.png",
    "goal": "goal.png",
}


def load_templates():

    result = {}

    for name, filename in TEMPLATE_FILES.items():

        path = BASE_DIR / filename

        image = cv2.imread(
            str(path),
            cv2.IMREAD_GRAYSCALE
        )

        if image is None:

            raise FileNotFoundError(
                f"템플릿 파일 없음: {path}"
            )

        result[name] = image

    return result


templates = load_templates()


# =========================================================
# 6. 가벼운 Template Matching
#
# 현재 상태에서 필요한 표식 1개만 검사하므로
# 모든 표식을 동시에 찾는 것보다 Raspberry Pi 부담이 작음.
# =========================================================
def template_score(gray_frame, template):

    fh, fw = gray_frame.shape[:2]
    th, tw = template.shape[:2]

    if (
        fh < th
        or fw < tw
    ):
        return 0.0

    result = cv2.matchTemplate(
        gray_frame,
        template,
        cv2.TM_CCOEFF_NORMED
    )

    _, max_value, _, _ = cv2.minMaxLoc(
        result
    )

    return float(max_value)


# =========================================================
# 7. 상태별로 지금 찾아야 하는 표식
# =========================================================
def target_for_state(state):

    if state == FIRST_STRAIGHT:
        return "arrow_normal"

    if state == TURN_TO_STOP_1:
        return "stop"

    if state == DRIVE_TO_ARROW_STATION:
        return "arrow_normal"

    if state == TURN_TO_STATION:
        return "station"

    if state == DRIVE_TO_ARROW_STOP:
        return "arrow_normal"

    if state == TURN_TO_STOP_2:
        return "stop"

    if state == DRIVE_TO_REVERSE_ARROW:
        return "arrow_reverse"

    if state == TURN_TO_NORMAL_ARROW:
        return "arrow_normal"

    if state == DRIVE_TO_GOAL:
        return "goal"

    return None


# =========================================================
# 8. Motor / Camera
# =========================================================
motor = Motor()
camera = Camera()

motor.enable_motor()
camera.start()


# =========================================================
# 9. 주행 함수
# =========================================================
def straight():

    motor.move(
        DRIVE_SPEED,
        DRIVE_SPEED
    )


def right_turn():

    motor.move(
        TURN_SPEED,
        -TURN_SPEED
    )


def full_stop():

    motor.stop()


# =========================================================
# 10. 정지 후 상태 변경
#
# 사용자가 말한 핵심:
# "멈추고 오른쪽으로 회전"
#
# 회전하기 전에 항상 stop()부터 실행.
# =========================================================
state = FIRST_STRAIGHT
state_start_time = time.monotonic()

presence = StablePresence()

arrow_count = 0
second_arrow_seen = False
last_arrow_event_time = -999.0


def change_state(new_state, stop_first=True):

    global state
    global state_start_time

    if stop_first:

        full_stop()
        time.sleep(STOP_PAUSE)

    state = new_state
    state_start_time = time.monotonic()

    presence.reset()

    print(
        f"\nSTATE -> {state}"
    )


# =========================================================
# 11. 시작
# =========================================================
print("")
print("========================================")
print(" Pinky Raspberry Pi Autonomous Sequence ")
print("========================================")
print("START")
print("")
print("1) 직진")
print("2) 정상 화살표 2번째가 사라지면 정지 후 우회전")
print("3) STOP 보이면 출발")
print("4) 다음 화살표에서 정지 후 STATION까지 우회전")
print("5) 다음 화살표에서 정지 후 STOP까지 우회전")
print("6) 반대 화살표에서 정지 후 우회전")
print("7) 정상 화살표가 보이면 직진")
print("8) GOAL 보이면 정지")
print("")


frame_counter = 0
last_status_print = 0.0


try:

    while True:

        # =================================================
        # 카메라
        # =================================================
        frame = camera.get_frame()

        if frame is None:

            time.sleep(0.02)
            continue


        # =================================================
        # 현재 상태에 따라 모터 동작
        # =================================================
        if state in (
            FIRST_STRAIGHT,
            DRIVE_TO_ARROW_STATION,
            DRIVE_TO_ARROW_STOP,
            DRIVE_TO_REVERSE_ARROW,
            DRIVE_TO_GOAL
        ):

            straight()


        elif state in (
            TURN_TO_STOP_1,
            TURN_TO_STATION,
            TURN_TO_STOP_2,
            TURN_TO_NORMAL_ARROW
        ):

            right_turn()


        elif state == DONE:

            full_stop()
            print("GOAL COMPLETE")
            break


        # =================================================
        # CPU 부담 감소
        # =================================================
        frame_counter += 1

        if (
            frame_counter
            % DETECT_EVERY_N_FRAMES
            != 0
        ):
            time.sleep(0.01)
            continue


        # 상태 변경 직후에는 잠깐 검출 무시
        if (
            time.monotonic()
            - state_start_time
            < IGNORE_AFTER_STATE_CHANGE
        ):
            time.sleep(0.01)
            continue


        # =================================================
        # 현재 상태에서 필요한 표식만 찾음
        # =================================================
        target = target_for_state(
            state
        )

        if target is None:

            time.sleep(0.01)
            continue


        gray = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2GRAY
        )


        score = template_score(
            gray,
            templates[target]
        )


        detected = (
            score
            >= THRESHOLDS[target]
        )


        event = presence.update(
            detected
        )


        # 1초에 한 번 상태 / score 출력
        now = time.monotonic()

        if (
            now
            - last_status_print
            >= 1.0
        ):

            print(
                f"[{state}] "
                f"target={target} "
                f"score={score:.2f}"
            )

            last_status_print = now


        # =================================================
        # 12. 첫 직선 구간
        #
        # 정상 화살표 등장 이벤트를 2번 카운트.
        # 두 번째 화살표가 화면에서 사라지는 순간:
        #
        # STOP -> RIGHT TURN
        # =================================================
        if state == FIRST_STRAIGHT:

            if event == "rise":

                if (
                    now
                    - last_arrow_event_time
                    >= ARROW_EVENT_COOLDOWN
                ):

                    arrow_count += 1
                    last_arrow_event_time = now

                    print(
                        f"NORMAL ARROW COUNT = "
                        f"{arrow_count}"
                    )


                    if arrow_count >= 2:

                        second_arrow_seen = True

                        print(
                            "SECOND ARROW SEEN"
                        )


            elif (
                event == "fall"
                and second_arrow_seen
            ):

                print(
                    "SECOND ARROW DISAPPEARED"
                )

                print(
                    "STOP -> RIGHT TURN"
                )

                change_state(
                    TURN_TO_STOP_1
                )


        # =================================================
        # 13. 첫 우회전
        #
        # STOP 글씨가 보일 때까지 회전.
        # STOP 보이면 회전 정지 후 출발.
        # =================================================
        elif state == TURN_TO_STOP_1:

            if event == "rise":

                print(
                    "STOP FOUND"
                )

                print(
                    "STOP TURN -> GO STRAIGHT"
                )

                change_state(
                    DRIVE_TO_ARROW_STATION
                )


        # =================================================
        # 14. 다음 화살표
        #
        # 화살표가 보이면:
        # STOP -> RIGHT TURN
        # =================================================
        elif state == DRIVE_TO_ARROW_STATION:

            if event == "rise":

                print(
                    "ARROW FOUND"
                )

                print(
                    "STOP -> TURN TO STATION"
                )

                change_state(
                    TURN_TO_STATION
                )


        # =================================================
        # 15. STATION 글씨까지 우회전
        # =================================================
        elif state == TURN_TO_STATION:

            if event == "rise":

                print(
                    "STATION FOUND"
                )

                print(
                    "STOP TURN -> GO STRAIGHT"
                )

                change_state(
                    DRIVE_TO_ARROW_STOP
                )


        # =================================================
        # 16. 그 다음 화살표
        #
        # 화살표가 보이면:
        # STOP -> RIGHT TURN
        # =================================================
        elif state == DRIVE_TO_ARROW_STOP:

            if event == "rise":

                print(
                    "ARROW FOUND"
                )

                print(
                    "STOP -> TURN TO STOP SIGN"
                )

                change_state(
                    TURN_TO_STOP_2
                )


        # =================================================
        # 17. STOP 글씨까지 우회전
        # =================================================
        elif state == TURN_TO_STOP_2:

            if event == "rise":

                print(
                    "STOP FOUND"
                )

                print(
                    "STOP TURN -> GO STRAIGHT"
                )

                change_state(
                    DRIVE_TO_REVERSE_ARROW
                )


        # =================================================
        # 18. 반대방향 화살표
        #
        # 반대 화살표가 보이면:
        # STOP -> RIGHT TURN
        # =================================================
        elif state == DRIVE_TO_REVERSE_ARROW:

            if event == "rise":

                print(
                    "REVERSE ARROW FOUND"
                )

                print(
                    "STOP -> RIGHT TURN"
                )

                change_state(
                    TURN_TO_NORMAL_ARROW
                )


        # =================================================
        # 19. 오른쪽으로 돌다가
        # 정상 화살표가 보이면 회전 종료 후 직진
        # =================================================
        elif state == TURN_TO_NORMAL_ARROW:

            if event == "rise":

                print(
                    "NORMAL ARROW FOUND"
                )

                print(
                    "STOP TURN -> FINAL STRAIGHT"
                )

                change_state(
                    DRIVE_TO_GOAL
                )


        # =================================================
        # 20. GOAL
        #
        # GOAL 글씨가 보이면 최종 정지
        # =================================================
        elif state == DRIVE_TO_GOAL:

            if event == "rise":

                print(
                    "GOAL FOUND"
                )

                change_state(
                    DONE
                )


        time.sleep(0.01)


except KeyboardInterrupt:

    print("")
    print("KeyboardInterrupt -> STOP")


finally:

    full_stop()

    try:
        motor.disable_motor()
    except Exception:
        pass

    try:
        motor.close()
    except Exception:
        pass

    try:
        camera.close()
    except Exception:
        pass

    print("PROGRAM END")
