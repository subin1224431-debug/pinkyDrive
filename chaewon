# =========================================================
# 주행 로직 전용 코드
#
# 전제:
#   - Raspberry Pi 환경/카메라/모터는 이미 구현되어 있음
#   - 아래 객체/함수는 기존 코드에 이미 존재한다고 가정
#
#       cap.read()          -> ret, frame
#       drive(left, right)  -> 모터 구동
#       stop()              -> 정지
#
# 이 코드에서는 pinkylib / HOST / requests / 서버 설정을 만들지 않음.
# =========================================================

import cv2
import numpy as np
import time


# =========================================================
# 1. 주행 설정
# =========================================================
DRIVE_SPEED = 23
TURN_SPEED = 22

# "멈춘 다음 회전/출발"을 확실히 하기 위한 짧은 대기
STOP_PAUSE = 0.35

# 상태가 바뀐 직후 이전 표식을 다시 잡는 것 방지
STATE_IGNORE_TIME = 0.60

# Raspberry Pi 부하 감소:
# 2프레임마다 한 번만 표식 확인
DETECT_EVERY_N_FRAMES = 2


# =========================================================
# 2. 표식 인식 설정
#
# 가장 단순한 OpenCV template matching 사용.
# 복잡한 YOLO/OCR 없음.
#
# 이 코드 파일과 같은 폴더 또는 아래 경로에
# 다음 이미지가 있어야 함.
#
#   arrow_normal.png
#   arrow_reverse.png
#   stop.png
#   station.png
#   goal.png
#
# 실제 로봇 카메라 화면에서 해당 표식만 잘라 저장하면 됨.
# =========================================================
TEMPLATE_PATHS = {
    "ARROW_NORMAL": "arrow_normal.png",
    "ARROW_REVERSE": "arrow_reverse.png",
    "STOP": "stop.png",
    "STATION": "station.png",
    "GOAL": "goal.png",
}

MATCH_THRESHOLD = {
    "ARROW_NORMAL": 0.68,
    "ARROW_REVERSE": 0.68,
    "STOP": 0.68,
    "STATION": 0.68,
    "GOAL": 0.68,
}

# 한 프레임만 우연히 잡힌 것은 무시
ON_FRAMES = 3

# 화면에서 사라졌다고 판단할 연속 미검출 프레임 수
OFF_FRAMES = 4


# =========================================================
# 3. 템플릿 불러오기
# =========================================================
templates = {}

for name, path in TEMPLATE_PATHS.items():

    img = cv2.imread(
        path,
        cv2.IMREAD_GRAYSCALE
    )

    if img is None:
        raise FileNotFoundError(
            f"{path} 파일을 찾을 수 없습니다."
        )

    templates[name] = img


# =========================================================
# 4. 가벼운 표식 인식
#
# 현재 상태에서 필요한 표식 1개만 검사함.
# 크기가 약간 달라져도 잡도록 3개 scale만 확인.
# =========================================================
def template_score(frame, template):

    gray = cv2.cvtColor(
        frame,
        cv2.COLOR_BGR2GRAY
    )

    # 연산량 감소
    h, w = gray.shape[:2]

    if w > 640:
        scale_down = 640.0 / w

        gray = cv2.resize(
            gray,
            None,
            fx=scale_down,
            fy=scale_down
        )

    best_score = 0.0

    for scale in (0.80, 1.00, 1.20):

        resized_template = cv2.resize(
            template,
            None,
            fx=scale,
            fy=scale
        )

        th, tw = resized_template.shape[:2]
        fh, fw = gray.shape[:2]

        if (
            th < 8
            or tw < 8
            or th >= fh
            or tw >= fw
        ):
            continue

        result = cv2.matchTemplate(
            gray,
            resized_template,
            cv2.TM_CCOEFF_NORMED
        )

        _, score, _, _ = cv2.minMaxLoc(
            result
        )

        if score > best_score:
            best_score = float(score)

    return best_score


# =========================================================
# 5. 표식이 실제로 등장/사라졌는지 안정적으로 확인
# =========================================================
class StableDetector:

    def __init__(self):

        self.active = False

        self.on_count = 0
        self.off_count = 0


    def reset(self):

        self.active = False

        self.on_count = 0
        self.off_count = 0


    def update(self, detected):

        # ---------------------------------------------
        # 표식이 보임
        # ---------------------------------------------
        if detected:

            self.on_count += 1
            self.off_count = 0

            if (
                not self.active
                and self.on_count >= ON_FRAMES
            ):

                self.active = True

                return "RISE"


        # ---------------------------------------------
        # 표식이 안 보임
        # ---------------------------------------------
        else:

            self.off_count += 1
            self.on_count = 0

            if (
                self.active
                and self.off_count >= OFF_FRAMES
            ):

                self.active = False

                return "FALL"


        return None


detector = StableDetector()


# =========================================================
# 6. 상태 정의
# =========================================================

# 처음 직진하면서 정상 화살표 두 개 확인
FIRST_STRAIGHT = "FIRST_STRAIGHT"

# 두 번째 화살표가 사라진 뒤 우회전하며 STOP 찾기
TURN_TO_FIRST_STOP = "TURN_TO_FIRST_STOP"

# STOP 이후 직진, 다음 화살표 찾기
DRIVE_TO_STATION_ARROW = "DRIVE_TO_STATION_ARROW"

# 화살표에서 멈춘 뒤 우회전하며 STATION 찾기
TURN_TO_STATION = "TURN_TO_STATION"

# STATION 이후 직진, 다음 화살표 찾기
DRIVE_TO_STOP_ARROW = "DRIVE_TO_STOP_ARROW"

# 화살표에서 멈춘 뒤 우회전하며 STOP 찾기
TURN_TO_SECOND_STOP = "TURN_TO_SECOND_STOP"

# STOP 이후 직진하며 반대방향 화살표 찾기
DRIVE_TO_REVERSE_ARROW = "DRIVE_TO_REVERSE_ARROW"

# 반대방향 화살표에서 우회전하며 정상 화살표 찾기
TURN_TO_NORMAL_ARROW = "TURN_TO_NORMAL_ARROW"

# 마지막 정상 화살표 이후 GOAL까지 직진
DRIVE_TO_GOAL = "DRIVE_TO_GOAL"

DONE = "DONE"


# =========================================================
# 7. 상태별로 찾아야 하는 표식
# =========================================================
def target_for_state(state):

    if state == FIRST_STRAIGHT:
        return "ARROW_NORMAL"

    if state == TURN_TO_FIRST_STOP:
        return "STOP"

    if state == DRIVE_TO_STATION_ARROW:
        return "ARROW_NORMAL"

    if state == TURN_TO_STATION:
        return "STATION"

    if state == DRIVE_TO_STOP_ARROW:
        return "ARROW_NORMAL"

    if state == TURN_TO_SECOND_STOP:
        return "STOP"

    if state == DRIVE_TO_REVERSE_ARROW:
        return "ARROW_REVERSE"

    if state == TURN_TO_NORMAL_ARROW:
        return "ARROW_NORMAL"

    if state == DRIVE_TO_GOAL:
        return "GOAL"

    return None


# =========================================================
# 8. 주행 상태 변수
# =========================================================
state = FIRST_STRAIGHT

state_changed_time = time.monotonic()

arrow_count = 0
second_arrow_seen = False

frame_count = 0


# =========================================================
# 9. 반드시 "멈춘 뒤" 상태 변경
# =========================================================
def change_state(new_state):

    global state
    global state_changed_time

    # ★ 핵심: 먼저 정지
    stop()

    time.sleep(
        STOP_PAUSE
    )

    state = new_state

    state_changed_time = (
        time.monotonic()
    )

    detector.reset()

    print(
        f"STATE -> {state}"
    )


# =========================================================
# 10. 자율주행 시작
# =========================================================
print("")
print("==============================")
print("AUTONOMOUS ROUTE START")
print("==============================")


try:

    while True:

        # =================================================
        # 카메라 프레임
        # =================================================
        ret, frame = cap.read()

        if not ret:

            stop()

            print(
                "CAMERA FRAME ERROR"
            )

            time.sleep(0.05)

            continue


        # =================================================
        # A. 현재 상태에 따른 기본 모터 동작
        # =================================================

        # ---------------------------------------------
        # 직진 상태
        # ---------------------------------------------
        if state in (
            FIRST_STRAIGHT,
            DRIVE_TO_STATION_ARROW,
            DRIVE_TO_STOP_ARROW,
            DRIVE_TO_REVERSE_ARROW,
            DRIVE_TO_GOAL
        ):

            drive(
                DRIVE_SPEED,
                DRIVE_SPEED
            )


        # ---------------------------------------------
        # 오른쪽 회전 상태
        # ---------------------------------------------
        elif state in (
            TURN_TO_FIRST_STOP,
            TURN_TO_STATION,
            TURN_TO_SECOND_STOP,
            TURN_TO_NORMAL_ARROW
        ):

            drive(
                TURN_SPEED,
                -TURN_SPEED
            )


        # ---------------------------------------------
        # 도착
        # ---------------------------------------------
        elif state == DONE:

            stop()

            print(
                "GOAL COMPLETE"
            )

            break


        # =================================================
        # B. Raspberry Pi 연산량 줄이기
        # =================================================
        frame_count += 1

        if (
            frame_count
            % DETECT_EVERY_N_FRAMES
            != 0
        ):

            continue


        # 상태가 막 바뀌었으면
        # 이전 표식을 바로 다시 잡지 않도록 잠깐 무시
        if (
            time.monotonic()
            - state_changed_time
            < STATE_IGNORE_TIME
        ):

            continue


        # =================================================
        # C. 현재 필요한 표식 하나만 검사
        # =================================================
        target = target_for_state(
            state
        )

        if target is None:
            continue


        score = template_score(
            frame,
            templates[target]
        )


        detected = (
            score
            >= MATCH_THRESHOLD[target]
        )


        event = detector.update(
            detected
        )


        # 필요하면 SSH 터미널에서 현재 값 확인 가능
        print(
            f"\r"
            f"{state} | "
            f"{target}: {score:.2f}",
            end=""
        )


        # =================================================
        # 11. 처음 직진
        #
        # 정상 화살표를 두 번 봄.
        # 두 번째 화살표가 카메라에서 완전히 사라지면:
        #
        # STOP -> 우회전
        # =================================================
        if state == FIRST_STRAIGHT:

            # 화살표 등장
            if event == "RISE":

                arrow_count += 1

                print(
                    f"\nARROW COUNT = "
                    f"{arrow_count}"
                )


                if arrow_count == 2:

                    second_arrow_seen = True

                    print(
                        "SECOND ARROW SEEN"
                    )


            # 두 번째 화살표가 사라짐
            elif (
                event == "FALL"
                and second_arrow_seen
            ):

                print(
                    "\nSECOND ARROW DISAPPEARED"
                )

                print(
                    "STOP -> RIGHT TURN"
                )


                change_state(
                    TURN_TO_FIRST_STOP
                )


        # =================================================
        # 12. 첫 번째 우회전
        #
        # STOP 글씨가 보일 때까지 회전.
        #
        # STOP이 보이면:
        # 회전 정지 -> 직진
        # =================================================
        elif state == TURN_TO_FIRST_STOP:

            if event == "RISE":

                print(
                    "\nSTOP FOUND"
                )


                change_state(
                    DRIVE_TO_STATION_ARROW
                )


        # =================================================
        # 13. 다음 화살표
        #
        # 화살표가 보이면:
        # 정지 -> 오른쪽 회전
        # =================================================
        elif state == DRIVE_TO_STATION_ARROW:

            if event == "RISE":

                print(
                    "\nARROW FOUND"
                )

                print(
                    "STOP -> TURN TO STATION"
                )


                change_state(
                    TURN_TO_STATION
                )


        # =================================================
        # 14. STATION 보일 때까지 회전
        # =================================================
        elif state == TURN_TO_STATION:

            if event == "RISE":

                print(
                    "\nSTATION FOUND"
                )


                change_state(
                    DRIVE_TO_STOP_ARROW
                )


        # =================================================
        # 15. 다음 화살표
        #
        # 화살표가 보이면:
        # 정지 -> 오른쪽 회전
        # =================================================
        elif state == DRIVE_TO_STOP_ARROW:

            if event == "RISE":

                print(
                    "\nARROW FOUND"
                )

                print(
                    "STOP -> TURN TO STOP SIGN"
                )


                change_state(
                    TURN_TO_SECOND_STOP
                )


        # =================================================
        # 16. STOP 글씨 보일 때까지 회전
        # =================================================
        elif state == TURN_TO_SECOND_STOP:

            if event == "RISE":

                print(
                    "\nSTOP FOUND"
                )


                change_state(
                    DRIVE_TO_REVERSE_ARROW
                )


        # =================================================
        # 17. 반대 방향 화살표
        #
        # 보이면:
        # 정지 -> 오른쪽 회전
        # =================================================
        elif state == DRIVE_TO_REVERSE_ARROW:

            if event == "RISE":

                print(
                    "\nREVERSE ARROW FOUND"
                )

                print(
                    "STOP -> RIGHT TURN"
                )


                change_state(
                    TURN_TO_NORMAL_ARROW
                )


        # =================================================
        # 18. 오른쪽으로 회전하다
        # 정상 화살표가 보이면:
        #
        # 정지 -> 직진
        # =================================================
        elif state == TURN_TO_NORMAL_ARROW:

            if event == "RISE":

                print(
                    "\nNORMAL ARROW FOUND"
                )

                print(
                    "STOP TURN -> FINAL STRAIGHT"
                )


                change_state(
                    DRIVE_TO_GOAL
                )


        # =================================================
        # 19. GOAL 글씨까지 직진
        # =================================================
        elif state == DRIVE_TO_GOAL:

            if event == "RISE":

                print(
                    "\nGOAL FOUND"
                )


                change_state(
                    DONE
                )


except KeyboardInterrupt:

    print(
        "\nUSER STOP"
    )


finally:

    stop()

    print(
        "\nPROGRAM END"
    )
